# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# Terraform binaries & working dirs (never commit these)
terraform
terraform.exe
terraform.zip
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider binaries
*.zip.download
/providers-cache/

# Staging / temp dirs created by CI and generate_schemas.py
generated-schemas-staging/
generated-schemas-backup/
generated-schemas-tmp*/
/tmp/

# Raw (uncompressed) provider schema JSON dumps — not deployment inputs
# (The compressed .json.gz files in generated-schemas/ ARE tracked by Git
#  because Vercel needs them at runtime.  Do NOT add generated-schemas/ here.)
*.schema.json

# App outputs (generated zips — ephemeral, not committed)
outputs/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
_status.txt
patch2.py

# Logs
*.log
uvicorn.log
