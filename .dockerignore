# .dockerignore
# Docker/local mode uses Terraform directly; pre-generated schemas are not
# needed in the image, so generated-schemas/ is excluded here to keep the
# build context lean.  It remains tracked by Git for Vercel.

# Pre-generated schemas (Vercel only; Docker uses Terraform directly)
generated-schemas/
generated-schemas-staging/
generated-schemas-backup/
generated-schemas-tmp*/

# Generated output zips (mounted as a volume at runtime)
outputs/

# Python bytecache
__pycache__/
*.py[cod]
*.pyo

# Terraform local state / downloaded providers / local binaries
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
terraform
terraform.exe
terraform.zip
*.zip.download
/providers-cache/

# Development / CI files not needed in the image
docker-compose.yml
.dockerignore
run_tests.py
README.md
LICENSE
LICENSE.txt
patch.py
_status.txt
scripts/
tests/
.github/

# Editor and OS artefacts
.git/
.gitignore
.DS_Store
*.swp
*.swo
*.log
